# ==============================================================================
# Checklist-Student — Flutter Web Environment Variables Example
# ==============================================================================
# คัดลอกไฟล์นี้เป็น `.env` สำหรับรันทดสอบบนเครื่องด้วยคำสั่ง:
#   flutter run -d chrome --web-port 8080 --dart-define-from-file=.env
#
# คำเตือนความปลอดภัย:
# - ห้าม commit ไฟล์ `.env`, `.env.local`, `env.json` หรือ `.vercel/` ขึ้น Git เด็ดขาด
# - ห้ามนำ `SUPABASE_SERVICE_ROLE_KEY` หรือ `GEMINI_API_KEY` มาใส่ฝั่ง Flutter Web
#   (คีย์ Gemini ฝั่ง AI Import ให้ตั้งเป็น Secret ใน Supabase Edge Functions เท่านั้น
#   ดูตัวอย่างใน `supabase/functions/.env.example`)
# ==============================================================================

# URL ของโปรเจกต์ Supabase (คัดลอกจาก Supabase Dashboard -> Project Settings -> API)
# ตัวอย่าง Local Docker: http://127.0.0.1:54321
# ตัวอย่าง Production:   https://your-project-ref.supabase.co
SUPABASE_URL=

# Public Anon Key ของ Supabase (ปลอดภัยสำหรับฝั่งเบราว์เซอร์ ควบคุมสิทธิ์ด้วย RLS 100%)
SUPABASE_ANON_KEY=
